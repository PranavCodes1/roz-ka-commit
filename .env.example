# Used ONLY by `npm run sync` (scripts/sync.js) and `npm run test:db`.
# The website itself never reads this file — the browser config lives in js/config.js
# and contains only the public anon/publishable key.
# Copy to .env (git-ignored) and fill in. Never commit .env.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public key (same one as in js/config.js). Needed by the integration tests.
SUPABASE_ANON_KEY=

# SECRET: service_role / sb_secret_… key. Server-side only (local CLI, GitHub Actions secret).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a GitHub personal access token with no scopes, to raise API rate limits.
GITHUB_TOKEN=
